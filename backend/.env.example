HOST=127.0.0.1
PORT=3001
# Google Client ID/Secret go in Supabase > Authentication > Google, not this file.
# See docs/engineering/google-auth-setup.md for exact console setup values.
SUPABASE_URL=
# The public project key is sufficient for token verification and sign-out.
SUPABASE_PUBLISHABLE_KEY=
# Server-only PostgreSQL credentials. Copy from Supabase > Connect.
# Session pooler (port 5432) works for both values on IPv4 networks.
DATABASE_URL=
DIRECT_URL=
