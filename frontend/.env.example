VITE_API_BASE_URL=/api
# Public Supabase project values. Google credentials belong in Supabase's dashboard.
# For Google setup, see docs/engineering/google-auth-setup.md.
# Use http://localhost:5174 consistently for the setup guide's local callbacks.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Dev proxy target; this value is used by Vite, not exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:3001
